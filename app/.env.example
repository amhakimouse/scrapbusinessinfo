# Copy this file to .env and fill in your own values.

# "stealthy" (headless browser, slower, bypasses more anti-bot) or "fast" (plain HTTP, quicker)
DEFAULT_FETCH_MODE=fast

# Seconds to wait between requests to the same domain (be a polite scraper)
REQUEST_DELAY=2.0

# Where results are stored (relative to project root)
LEADS_FILE=data/leads.json

# Only used by scraper/discovery.py if you enable search-based discovery
SEARCH_RESULTS_PER_KEYWORD=15
